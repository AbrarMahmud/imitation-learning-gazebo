<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="push_t_world">
    <include><uri>model://sun</uri></include>
    <include><uri>model://ground_plane</uri></include>

    <light name="table_spotlight" type="directional">
      <cast_shadows>true</cast_shadows>
      <pose>0.35 0 2.5 0 0 0</pose> <diffuse>0.8 0.8 0.7 1</diffuse> <specular>0.3 0.3 0.3 1</specular> <attenuation>
        <range>5</range>
        <constant>0.9</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>
      <direction>0 0 -1</direction>
    </light>

    <model name="surface_table">
      <static>true</static>
      <pose>0.35 0 0.25 0 0 0</pose> 
      <link name="table_link">
        <collision name="collision">
          <geometry><box><size>1.0 1.2 0.5</size></box></geometry>
          <surface>
            <friction>
              <ode>
                <mu>0.1</mu>
                <mu2>0.1</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        
        <visual name="visual">
          <geometry><box><size>1.0 1.2 0.5</size></box></geometry>
          <material>
            <script>
              <uri>file://media/materials/scripts/gazebo.material</uri>
              <name>Gazebo/Wood</name>
            </script>
          </material>
        </visual>
      </link>
    </model>
  </world>
</sdf>

<?xml version="1.0"?>
<robot name="t_object" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="scale" default="1.0"/>
  <xacro:property name="s" value="$(arg scale)"/>

  <link name="object_link">
    <inertial>
      <mass value="${0.05 * s * s * s}"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
    <collision><geometry><box size="${0.04*s} ${0.16*s} 0.015"/></geometry></collision>
    <visual><geometry><box size="${0.04*s} ${0.16*s} 0.015"/></geometry></visual>
    <collision>
      <origin xyz="${0.06*s} 0 0"/>
      <geometry><box size="${0.08*s} ${0.04*s} 0.015"/></geometry>
    </collision>
    <visual>
      <origin xyz="${0.06*s} 0 0"/>
      <geometry><box size="${0.08*s} ${0.04*s} 0.015"/></geometry>
    </visual>
  </link>
  <gazebo reference="object_link"><material>Gazebo/Blue</material></gazebo>
</robot>

<?xml version="1.0"?>
<robot name="t_mark" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="scale" default="1.0"/>
  <xacro:property name="s" value="$(arg scale)"/>

  <link name="mark_link">
    <inertial>
      <mass value="0.001"/>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>

    <visual>
      <geometry>
        <box size="${0.3 * s} ${0.3 * s} 0.0"/>
      </geometry>
    </visual>
  </link>

  <gazebo reference="mark_link">
    <material>Gazebo/Red</material>
  </gazebo>

  <gazebo>
    <static>true</static>
  </gazebo>
</robot>

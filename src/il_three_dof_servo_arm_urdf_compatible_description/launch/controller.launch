<launch>

<rosparam file="$(find il_three_dof_servo_arm_urdf_compatible_description)/launch/controller.yaml" command="load"/>
<node name="controller_spawner" pkg="controller_manager" type="spawner" respawn="false" output="screen" ns="il_three_dof_servo_arm_urdf_compatible" args="joint_1_position_controller joint_2_position_controller joint_3_position_controller joint_state_controller "/>
<node name="robot_state_publisher" pkg="robot_state_publisher" type="robot_state_publisher" respawn="false" output="screen">
  <remap from="/joint_states" to="/il_three_dof_servo_arm_urdf_compatible/joint_states"/>
</node>

</launch>